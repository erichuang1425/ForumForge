{
  "name": "@forumforge/extension",
  "version": "0.1.0",
  "private": true,
  "description": "ForumForge browser extension — an on-demand immersive thread reader with a compact page launcher and local library.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.mjs",
    "build:release": "node build.mjs --release",
    "test": "vitest run --root ../.. apps/extension/test"
  },
  "dependencies": {
    "@forumforge/core": "workspace:*",
    "@forumforge/parser": "workspace:*",
    "@forumforge/storage": "workspace:*"
  }
}
