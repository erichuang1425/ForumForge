{
  "name": "forumforge",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, local-first browser extension and adapter framework for modernizing forum threads.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "repo:check": "node scripts/check-repository.mjs && node scripts/version.mjs check",
    "build:check": "node scripts/verify-build.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm repo:check && pnpm build:check",
    "package:extension": "pnpm build && node scripts/package-extension.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "linkedom": "^0.18.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
